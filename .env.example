# Copy file này thành docker-compose/.env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — KHÔNG commit file .env.
# Docker Compose đọc .env từ "project directory" = thư mục của compose file
# (hoặc dùng --env-file / --project-directory nếu muốn chỗ khác).
ND_LASTFM_APIKEY=your_lastfm_api_key
ND_LASTFM_SECRET=your_lastfm_secret
